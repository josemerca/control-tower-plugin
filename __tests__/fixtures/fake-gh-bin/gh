#!/usr/bin/env node
// Stub de `gh` para tests: NUNCA toca la red ni ningún repo real. Controlado
// enteramente por variables de entorno para que los tests de
// dispatch-check-dryrun.test.js puedan simular fallos de `gh` (auth, rate
// limit, red) en puntos concretos de la secuencia de claim sin llamar al `gh`
// real. Ver ese fichero de test para el uso de cada variable.
import { readFileSync, writeFileSync, existsSync, appendFileSync } from 'node:fs'
import { waitForReleaseFile } from '../stub-wait.js'

const argv = process.argv.slice(2)
const joined = argv.join(' ')

// FAKE_GH_ARGV_LOG_FILE (review final, finding 2): registra el argv exacto de
// cada invocación para que los tests puedan comprobar que la enumeración de
// issues usa `--paginate` (paginación real) y NUNCA `--limit` (el tope fijo
// que reintroduce el bug de truncado silencioso) — sin esto no hay forma de
// distinguir, desde un stub que ignora los flags, si el comando real seguiría
// truncando contra GitHub de verdad.
if (process.env.FAKE_GH_ARGV_LOG_FILE) {
  appendFileSync(process.env.FAKE_GH_ARGV_LOG_FILE, joined + '\n')
}

function nextCallIndex(counterFile) {
  if (!counterFile) return 0
  let n = 0
  if (existsSync(counterFile)) n = parseInt(readFileSync(counterFile, 'utf8'), 10) || 0
  writeFileSync(counterFile, String(n + 1))
  return n
}

// FAKE_GH_LIST_SEQUENCE_FILE (D2 review, menor 4/maxBuffer): lee la secuencia
// desde un FICHERO en vez del contenido inline de FAKE_GH_LIST_SEQUENCE —
// necesario para reproducir una respuesta de varios MiB (p.ej. una colisión
// con miles de issues en vuelo) sin pasarla por una variable de entorno: en
// macOS ARG_MAX (`getconf ARG_MAX`) es ~1 MiB para todo el argv+environ
// combinado, así que un solo env var de varios MiB directamente revienta el
// propio `spawnSync` del test (no llega ni a ejecutar el hijo). Un fichero,
// en cambio, no tiene ese límite — solo la RUTA viaja por env. Si no se
// define, se sigue leyendo FAKE_GH_LIST_SEQUENCE inline como hasta ahora (sin
// cambio de comportamiento por defecto).
function loadSequence() {
  if (process.env.FAKE_GH_LIST_SEQUENCE_FILE) {
    return JSON.parse(readFileSync(process.env.FAKE_GH_LIST_SEQUENCE_FILE, 'utf8'))
  }
  return JSON.parse(process.env.FAKE_GH_LIST_SEQUENCE || '[[]]')
}

// main(): TODA la lógica de despacho vive aquí, con `return` en vez de
// `process.exit(N)` en cada rama (D2 review, menor 4 — hallazgo colateral al
// construir el test de maxBuffer): `process.stdout`/`process.stderr` son
// ASÍNCRONOS hacia una tubería en POSIX (documentado explícitamente en los
// propios docs de Node: "Pipes (and sockets): asynchronous on POSIX"), que es
// exactamente cómo execFileSync conecta con este script. `process.exit(N)`
// termina el proceso YA, sin esperar a que un `write()` grande en vuelo
// termine de vaciarse — un payload de varios MiB (como el que exige un test
// real del `maxBuffer` de ct-next.mjs) se trunca en silencio a un múltiplo
// del tamaño del buffer del pipe del SO (64 KiB en este Mac), con independen
// cia de cualquier `maxBuffer` que fije el LADO QUE LEE. Verificado por
// construcción: con la versión vieja (`process.exit()` inmediato tras el
// `write`), un payload de ~11 MB de JSON llegaba truncado a 64 KiB al otro
// lado. Fijar `process.exitCode` y dejar que el script termine solo (sin
// `process.exit()`) permite que Node vacíe la tubería antes de salir de
// verdad — ver la variante de este mismo experimento en
// /private/tmp/.../node-repro/parent-nobuf.js vs parent-withbuf.js. Esto es
// puramente una propiedad del STUB (nunca tocó al `gh` real ni a
// dispatch-check.mjs/ct-next.mjs), así que no cambia el comportamiento de
// NINGÚN test existente con payloads pequeños — solo hace correcto (en vez
// de "funciona por casualidad porque nunca se probó con algo grande") el
// caso de un payload grande. (D1+D2: el mismo `return`-en-vez-de-`exit`
// aplica ahora también a los bloques de milestones/label-create que D1
// (`fix/dispatch-graph-hardening`) añadió para F5/ct-groom.mjs — no tenían
// razón para quedar fuera de esta protección solo por venir de la otra rama.)
function main() {
  if (argv[0] === 'issue' && argv[1] === 'edit') {
    // FAKE_GH_EDIT_WAIT_FILE (F8): se queda DENTRO de este `issue edit` hasta
    // que el test cree el fichero centinela. Sustituye a la ventana de tiempo
    // de FAKE_GH_EDIT_DELAY_MS en los tests que necesitan mandar una señal
    // "mientras el claim se está escribiendo": el argv ya quedó registrado
    // arriba (appendFileSync, síncrono), así que el test puede detectar por
    // fichero que estamos aquí dentro, mandar la señal con toda la calma del
    // mundo, y solo entonces soltarnos. Ver __tests__/fixtures/stub-wait.js
    // para el razonamiento completo.
    //
    // OJO al alcance: esto bloquea TODO `issue edit`, incluido el revert
    // automático posterior. Es intencionado y no molesta — cuando ct-next
    // llega al revert, el centinela ya existe desde hace rato y la espera es
    // un no-op.
    waitForReleaseFile('FAKE_GH_EDIT_WAIT_FILE')
    // FAKE_GH_EDIT_DELAY_MS (finding 1, test de reentrada de señal): ensancha
    // de forma determinista la ventana en la que ct-next.mjs está bloqueado
    // DENTRO del propio revert automático (gh() es una llamada síncrona) —
    // necesaria para poder enviar una SEGUNDA señal mientras la primera
    // todavía se está gestionando, sin depender de ganar una carrera contra
    // el scheduler del SO bajo carga variable. Síncrono a propósito (este
    // es el HIJO simulando latencia real de gh, no el propio ct-next.mjs).
    const delayMs = Number(process.env.FAKE_GH_EDIT_DELAY_MS || 0)
    if (delayMs > 0) {
      const sab = new Int32Array(new SharedArrayBuffer(4))
      Atomics.wait(sab, 0, 0, delayMs)
    }
    const failSubstr = process.env.FAKE_GH_EDIT_FAIL_SUBSTR
    if (failSubstr && joined.includes(failSubstr)) {
      console.error('fake-gh: issue edit failed (simulado)')
      process.exitCode = 1
      return
    }
    process.exitCode = 0
    return
  }

  // `gh issue create --repo <r> --title … --body … --milestone … --label …`
  // (ct-groom.mjs). Devuelve por stdout la URL del issue creado, que es lo
  // que gh imprime de verdad y lo que ct-groom.mjs pasa después a `gh project
  // item-add --url`. F6: hasta ahora NINGÚN test de CLI llegaba a esta rama —
  // todos los tests de corrida real de ct-groom partían de issues ya
  // existentes, así que el camino de CREACIÓN (el más común en producción:
  // groomear un epic nuevo) no se ejecutaba nunca en la suite. Numera desde
  // el 900 para que ningún número creado se confunda con los fixtures de
  // issues existentes (501/502…).
  if (argv[0] === 'issue' && argv[1] === 'create') {
    if (process.env.FAKE_GH_ISSUE_CREATE_FAIL) {
      console.error('fake-gh: issue create failed (simulado)')
      process.exitCode = 1
      return
    }
    const n = nextCallIndex(process.env.FAKE_GH_CREATE_COUNTER_FILE)
    process.stdout.write(`https://github.com/o/r/issues/${900 + n}\n`)
    process.exitCode = 0
    return
  }

  if (argv[0] === 'issue' && argv[1] === 'view') {
    // FAKE_GH_VIEW_FAIL (D2, finding 3): simula que `labelsOf()` (la lectura
    // de labels del propio candidato en dispatch-check.mjs) falla — auth
    // caída, rate limit, red — ANTES de cualquier escritura. Sin esto no
    // había forma de distinguir, desde un stub, "no se pudo leer el estado
    // del candidato" (fallo de infraestructura) de "colisión detectada"
    // (resultado normal del protocolo): ambos casos, antes de este fix,
    // terminaban en el mismo exit 1 de dispatch-check que ct-next trataba
    // siempre como "salta y sigue".
    // FAKE_GH_VIEW_FAIL_AT (D2 review, menor 3): variante indexada de
    // FAKE_GH_VIEW_FAIL — falla solo la N-ésima llamada a `issue view`
    // (0-based, contador PROPIO vía FAKE_GH_VIEW_COUNTER_FILE, independiente
    // del contador de FAKE_GH_LIST_SEQUENCE) en vez de TODAS. Necesario para
    // probar que un fallo de infraestructura en UN candidato de la tanda no
    // impide intentar el SIGUIENTE — con FAKE_GH_VIEW_FAIL (sin índice)
    // fallarían los dos por igual y no se podría distinguir "aborta toda la
    // tanda" de "sigue con el resto".
    const viewCallIndex = nextCallIndex(process.env.FAKE_GH_VIEW_COUNTER_FILE)
    const viewFailAt = process.env.FAKE_GH_VIEW_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_VIEW_FAIL_AT) : null
    if (process.env.FAKE_GH_VIEW_FAIL || (viewFailAt !== null && viewCallIndex === viewFailAt)) {
      console.error('fake-gh: issue view failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(process.env.FAKE_GH_VIEW_LABELS || '[]')
    process.exitCode = 0
    return
  }

  if (argv[0] === 'issue' && argv[1] === 'list') {
    const callIndex = nextCallIndex(process.env.FAKE_GH_COUNTER_FILE)
    const failAt = process.env.FAKE_GH_LIST_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_LIST_FAIL_AT) : null
    if (failAt !== null && callIndex === failAt) {
      console.error('fake-gh: issue list failed (simulado)')
      process.exitCode = 1
      return
    }
    const seq = loadSequence()
    const out = seq[Math.min(callIndex, seq.length - 1)]
    process.stdout.write(JSON.stringify(out))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/issues ... --paginate --slurp` (review
  // final, finding 2): ct-next.mjs y dispatch-check.mjs enumeran issues
  // abiertos/cerrados por este endpoint REST en vez de `gh issue list --limit
  // N`, para no reintroducir el truncado silencioso. Reutiliza EXACTAMENTE la
  // misma secuenciación por contador que el bloque `issue list` de arriba,
  // para que los tests existentes (que ya orquestan una llamada de
  // "abiertos" seguida de una de "cerrados"/readback vía
  // FAKE_GH_LIST_SEQUENCE) sigan funcionando sin cambios tras el cambio de
  // comando subyacente.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/issues$/.test(argv[1] || '')) {
    const callIndex = nextCallIndex(process.env.FAKE_GH_COUNTER_FILE)
    const failAt = process.env.FAKE_GH_LIST_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_LIST_FAIL_AT) : null
    if (failAt !== null && callIndex === failAt) {
      console.error('fake-gh: api issues failed (simulado)')
      process.exitCode = 1
      return
    }
    const seq = loadSequence()
    const out = seq[Math.min(callIndex, seq.length - 1)]
    process.stdout.write(JSON.stringify(out))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/milestones ...` (ct-groom.mjs, F5): el
  // listado (GET explícito, `--method GET -f state=all --paginate`) y la
  // creación (POST implícito, sin `--method`, solo `-f title=<t>`) comparten
  // el mismo endpoint REST — se distinguen por la presencia de `--method` en
  // argv (el listado SIEMPRE lo pasa explícito; la creación nunca).
  // FAKE_GH_MILESTONES_LIST controla la respuesta del listado (default: "[]",
  // ningún milestone existente); FAKE_GH_MILESTONE_CREATE_NUMBER controla el
  // número devuelto al "crear" uno (default: 1). Los tests de F5 (detección de
  // divergencia / --reconcile) siempre dan por hecho un milestone YA
  // existente que matchea el título del plan, precisamente para no tener que
  // ejercitar la rama de creación — es una feature ortogonal, ya cableada y
  // sin tests de CLI propios antes de F5.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/milestones$/.test(argv[1] || '')) {
    if (argv.includes('--method')) {
      process.stdout.write(process.env.FAKE_GH_MILESTONES_LIST || '[]')
      process.exitCode = 0
      return
    }
    process.stdout.write(JSON.stringify({ number: Number(process.env.FAKE_GH_MILESTONE_CREATE_NUMBER || 1) }))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/labels --method GET --paginate --slurp`
  // (ct-groom.mjs, F6 menor 5): las labels que YA existen en el repo, para
  // poder distinguir "reutilicé una" de "me inventé una nueva" y para no
  // reescribir con --force las que ya estaban. FAKE_GH_LABELS_LIST trae la
  // respuesta YA en forma de --slurp (array de páginas: [[{name},…]]);
  // default "[[]]" (repo sin ninguna label), que es lo correcto para los
  // tests anteriores a F6 — con él, todas las labels del plan salen como
  // "creadas nuevas", igual que hacía el `--force` incondicional de antes.
  // FAKE_GH_LABELS_FAIL simula que el listado falla (auth/red/rate limit).
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/labels$/.test(argv[1] || '')) {
    if (process.env.FAKE_GH_LABELS_FAIL) {
      console.error('fake-gh: api labels failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(process.env.FAKE_GH_LABELS_LIST || '[[]]')
    process.exitCode = 0
    return
  }

  // `gh api repos/<o>/<r>/contents/<ruta>?ref=<rama> -H "Accept:
  // application/vnd.github.html"` (ct-groom.mjs, F10): el spec RENDERIZADO por
  // GitHub. ct-groom.mjs lo pide por dos cosas a la vez — que el fichero
  // exista de verdad en esa rama (si no, no hay enlace que escribir) y que el
  // ancla que ha calculado del encabezado esté de verdad en el HTML.
  //
  // FAKE_GH_CONTENTS_FAIL simula el 404 del caso más común de la vida real:
  // el spec escrito pero todavía sin empujar.
  // FAKE_GH_CONTENTS_ANCHORS es la lista (separada por espacios) de anclas
  // que "tiene" el documento publicado. El default cubre los dos encabezados
  // §9 que usan los specs de esta suite ("## 9. Slices" -> "9-slices" y
  // "## 9. Algo" -> "9-algo"); un test que quiera ejercer "el ancla no está
  // en la copia publicada" lo fija a otra cosa (o a vacío).
  //
  // El HTML es deliberadamente mínimo y ESCRITO A MANO, no generado con
  // scripts/anchor.js: si el stub calculara el ancla con el mismo código que
  // la produce, el test no comprobaría nada. La forma (`<a id="user-content-…"
  // class="anchor">`) es la real, copiada de una respuesta de GitHub.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/contents\//.test(argv[1] || '')) {
    if (process.env.FAKE_GH_CONTENTS_FAIL) {
      console.error('fake-gh: api contents failed (simulado: 404 Not Found)')
      process.exitCode = 1
      return
    }
    const anchors = (process.env.FAKE_GH_CONTENTS_ANCHORS ?? '9-slices 9-algo').split(/\s+/).filter(Boolean)
    const body = anchors.map((a) => `<div class="markdown-heading"><h2 class="heading-element">x</h2><a id="user-content-${a}" class="anchor" href="#${a}"></a></div>`).join('\n')
    process.stdout.write(`<div id="file" class="md"><article class="markdown-body">\n${body}\n</article></div>`)
    process.exitCode = 0
    return
  }

  // ---- Project v2 (ct-groom.mjs --project) --------------------------------
  // F15/H2: hasta ahora el stub NO soportaba ninguna llamada de `project`, así
  // que todo test con --project moría en "comando no soportado" — es decir, la
  // única forma de ejercitar --project era que fallara. Sin poder simular un
  // project SANO no se puede comprobar el ORDEN de las mutaciones (que es lo
  // que H2 pone en el contrato), solo el camino de error.
  //
  //   FAKE_GH_PROJECT_VIEW_FAIL   → `gh project view` falla (project inexistente/auth).
  //   FAKE_GH_PROJECT_FIELDS      → JSON de `data.node.fields.nodes` para la query de
  //                                 campos. Default: un campo "Sprint" con una iteración
  //                                 que empieza HOY y dura 14 días (o sea, vigente).
  //                                 `[]` simula "no hay campo Sprint"; un Sprint con una
  //                                 iteración vieja simula "ninguna iteración cubre hoy".
  //   FAKE_GH_PROJECT_ITEMS       → JSON de `.items` para `project item-list` (default []).
  if (argv[0] === 'project' && argv[1] === 'view') {
    if (process.env.FAKE_GH_PROJECT_VIEW_FAIL) {
      console.error('fake-gh: project view failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(JSON.stringify({ id: 'PVT_fake' }))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'project' && argv[1] === 'item-list') {
    process.stdout.write(JSON.stringify({ items: JSON.parse(process.env.FAKE_GH_PROJECT_ITEMS || '[]') }))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'project' && argv[1] === 'item-add') {
    process.stdout.write(JSON.stringify({ id: 'PVTI_fake' }))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'api' && argv[1] === 'graphql') {
    // Query de campos vs mutación de iteración: se distinguen por el texto de
    // la propia query, igual que ct-groom.mjs las emite.
    const isFieldsQuery = joined.includes('ProjectV2IterationField')
    if (!isFieldsQuery) {
      process.stdout.write(JSON.stringify({ data: { updateProjectV2ItemFieldValue: { projectV2Item: { id: 'PVTI_fake' } } } }))
      process.exitCode = 0
      return
    }
    let nodes
    if (process.env.FAKE_GH_PROJECT_FIELDS) {
      nodes = JSON.parse(process.env.FAKE_GH_PROJECT_FIELDS)
    } else {
      const today = new Date().toISOString().slice(0, 10)
      nodes = [{ id: 'PVTIF_fake', name: 'Sprint', configuration: { iterations: [{ id: 'ITER_fake', title: 'Sprint actual', startDate: today, duration: 14 }] } }]
    }
    process.stdout.write(JSON.stringify({ data: { node: { fields: { nodes } } } }))
    process.exitCode = 0
    return
  }

  // `gh label create <name> --repo <repo> --force` (ct-groom.mjs): una
  // llamada por cada label distinta que el plan produce Y que el repo no
  // tenía ya (F6), antes de crear/actualizar ningún issue. Siempre éxito —
  // ningún test existente necesita simular su fallo (label create con
  // --force no tiene, en la práctica, un caso "ya existe" que tratar como
  // error).
  if (argv[0] === 'label' && argv[1] === 'create') {
    process.exitCode = 0
    return
  }

  // `gh repo view <repo> --json defaultBranchRef -q .defaultBranchRef.name`
  // (W-D): ct-next.mjs resuelve la rama por defecto real del repo en vez de
  // asumir "main" a ciegas. FAKE_GH_DEFAULT_BRANCH controla el valor
  // devuelto (default: "main", para que los tests existentes que no fijan
  // esta variable — y que no les importa qué rama base se use — sigan
  // pasando sin cambios). FAKE_GH_REPO_VIEW_FAIL simula que gh no puede
  // resolverlo (repo no encontrado, auth caída, sin red, etc.).
  //
  // Fix round 1, Minor 3 (review de W-D): `??` en vez de `||` — con `||`,
  // fijar FAKE_GH_DEFAULT_BRANCH a la cadena vacía ('') seguía cayendo a
  // 'main' ('' es falsy), así que la rama de "gh repo view no devolvió nada"
  // de detectDefaultBranch en ct-next.mjs era intestable con este stub. `??`
  // solo cae al default cuando la variable no está definida en absoluto —
  // una cadena vacía explícita se propaga tal cual, alcanzando de verdad esa
  // rama.
  if (argv[0] === 'repo' && argv[1] === 'view') {
    if (process.env.FAKE_GH_REPO_VIEW_FAIL) {
      console.error('fake-gh: repo view failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(`${process.env.FAKE_GH_DEFAULT_BRANCH ?? 'main'}\n`)
    process.exitCode = 0
    return
  }

  console.error(`fake-gh: comando no soportado en el stub: ${joined}`)
  process.exitCode = 1
}

main()

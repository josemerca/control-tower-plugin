#!/bin/sh
# `claude` tal y como lo vería el shell de login que abre cmux (F19/H1).
#
# NO confundir con __tests__/fixtures/fake-claude-bin/claude, que existe para
# GRITAR si ct-next.mjs ejecutara `claude` por su cuenta (no lo hace, y ese
# contrato sigue en pie). Este otro lo ejecuta el shell simulado del stub de
# cmux — que es exactamente quien lo ejecuta en la vida real — así que aquí lo
# correcto es salir en silencio y con éxito: el agente arrancó.
#
# No imprime nada a propósito: su salida iría al mismo stdout/stderr que los
# tests inspeccionan para juzgar los mensajes de ct-next.mjs.
#
# F20/H1 — FAKE_CMUX_CLAUDE_RUNS_FILE: una `X` por invocación. Desde que
# /ct-next REENVÍA la línea cuando el centinela no aparece, "arrancó" ya no
# basta: hay que poder demostrar que arrancó UNA VEZ. Sin este contador, un
# doble lanzamiento sobre el mismo worktree —dos agentes pisándose— pasaría
# por un despacho perfecto en todos los tests.
if [ -n "$FAKE_CMUX_CLAUDE_RUNS_FILE" ]; then
  printf 'X' >> "$FAKE_CMUX_CLAUDE_RUNS_FILE"
fi
exit 0

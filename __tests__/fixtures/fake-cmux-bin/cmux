#!/usr/bin/env node
// Stub de `cmux` para los tests de ct-next.mjs: NUNCA lanza un workspace real.
// FAKE_CMUX_FAIL hace fallar toda invocación de `new-workspace`;
// FAKE_CMUX_FAIL_NAME_SUBSTR hace fallar solo la invocación cuyo `--name`
// contiene ese substring (para el test de "falla a mitad del bucle con
// varios slices seleccionados").
//
// Finding 2 (staleness) y finding 3 (verificación de lanzamiento) añaden dos
// consultas de SOLO LECTURA — `list-windows --json` y `workspace list
// --window <id> --json` — que ct-next.mjs usa para (a) comprobar si hay una
// sesión viva para un issue en vuelo, y (b) comprobar, DESPUÉS de que
// `new-workspace` ya devolvió éxito, si la sesión recién creada está de
// verdad en el cwd pedido. Ninguna de las dos lanza nada.
//
// Para que finding 3 sea comprobable de verdad (y para que los tests
// EXISTENTES de "lanzamiento con éxito" — escritos antes de que esta
// verificación existiera — sigan viendo "lanzado #N" sin tener que tocar
// cada uno de ellos), este stub es STATEFUL: cada `new-workspace` que NO
// falla registra su `--name`/`--cwd` en un fichero de estado, y
// `workspace list --json` lo lee de vuelta. El fichero de estado, si no se
// fija explícitamente con FAKE_CMUX_STATE_FILE, se deriva de
// FAKE_GIT_TOPLEVEL (que CADA test de ct-next.mjs ya fija a un directorio
// temporal aislado por test) — así el aislamiento entre tests es automático,
// sin tener que añadir una variable nueva a los 654 tests preexistentes.
import { readFileSync, writeFileSync, existsSync, appendFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { waitForReleaseFile } from '../stub-wait.js'

const argv = process.argv.slice(2)

// FAKE_CMUX_INVOKED_LOG_FILE: registra CUALQUIER invocación de este stub
// (subcomando + argv), para que un test pueda comprobar que cmux NUNCA se
// invocó en absoluto — p.ej. CT_NEXT_FIXTURE, que promete no tocar nada
// real, ni siquiera de solo lectura (ver la guarda `if (fx) return null` en
// queryAllCmuxWorkspaces, ct-next.mjs).
if (process.env.FAKE_CMUX_INVOKED_LOG_FILE) {
  appendFileSync(process.env.FAKE_CMUX_INVOKED_LOG_FILE, argv.join(' ') + '\n')
}

function stateFilePath() {
  if (process.env.FAKE_CMUX_STATE_FILE) return process.env.FAKE_CMUX_STATE_FILE
  if (process.env.FAKE_GIT_TOPLEVEL) return join(process.env.FAKE_GIT_TOPLEVEL, '.fake-cmux-workspaces.json')
  return null
}

function readState() {
  const f = stateFilePath()
  if (!f || !existsSync(f)) return []
  try {
    return JSON.parse(readFileSync(f, 'utf8'))
  } catch {
    return []
  }
}

function appendState(entry) {
  const f = stateFilePath()
  if (!f) return // sin fichero de estado disponible: no-op, mismo comportamiento que antes de finding 3.
  const cur = readState()
  cur.push(entry)
  writeFileSync(f, JSON.stringify(cur))
}

if (argv[0] === 'list-windows' && argv.includes('--json')) {
  if (process.env.FAKE_CMUX_LIST_WINDOWS_FAIL) {
    console.error('fake-cmux: list-windows failed (simulado, daemon no disponible)')
    process.exit(1)
  }
  process.stdout.write(process.env.FAKE_CMUX_WINDOWS_JSON || JSON.stringify([{ id: 'win1' }]))
  process.exit(0)
}

if (argv[0] === 'workspace' && argv[1] === 'list' && argv.includes('--json')) {
  // FAKE_CMUX_WORKSPACE_TITLES_JSON (finding 2): sesiones PRE-EXISTENTES que
  // un test quiere simular sin haberlas "lanzado" en esta misma corrida
  // (p.ej. "hay una sesión de otro slice ya abierta"). Se combinan con lo
  // que el propio proceso bajo prueba haya lanzado de verdad en esta corrida
  // (el estado stateful de arriba) — ninguna de las dos fuentes pisa a la
  // otra.
  const staticTitles = process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON ? JSON.parse(process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON) : []
  const launched = readState()
  // FAKE_CMUX_SCHEMA_MISMATCH (finding 2/3, ataque adversarial de una
  // revisión externa): simula una versión de cmux que renombró el campo
  // (p.ej. `title` en vez de `custom_title`) — hay entradas de verdad, pero
  // NINGUNA con el nombre de campo que ct-next.mjs espera. Sirve para
  // probar que esto se trata como NO CONCLUYENTE (queryAllCmuxWorkspaces
  // devuelve null), nunca como "confirmado: cero sesiones", que sería un
  // falso positivo ruidoso en cada dispatch.
  if (process.env.FAKE_CMUX_SCHEMA_MISMATCH) {
    const workspaces = [...staticTitles, ...launched.map((e) => e.title)].map((t) => ({ title: t, cwd: null }))
    process.stdout.write(JSON.stringify({ workspaces }))
    process.exit(0)
  }
  // FAKE_CMUX_CWD_FIELD_RENAMED (D5, hallazgo B): simula una versión de cmux
  // que renombró SOLO el campo del directorio (`cwd` en vez de
  // `current_directory`) y mantiene `custom_title`. Es el caso que la guarda
  // de esquema anterior NO cubría: el título se reconoce (así que
  // `sawAnyRecognizedTitle` no salva nada), pero cada `current_directory`
  // sale `undefined` y, con la comparación estricta de antes, CADA
  // lanzamiento correcto se clasificaba como 'wrong-cwd' — falsa alarma en
  // cada dispatch, y con consecuencia de exit code (0 → 3).
  if (process.env.FAKE_CMUX_CWD_FIELD_RENAMED) {
    const workspaces = [
      ...staticTitles.map((t) => ({ custom_title: t, cwd: null })),
      ...launched.map((e) => ({ custom_title: e.title, cwd: e.cwd })),
    ]
    process.stdout.write(JSON.stringify({ workspaces }))
    process.exit(0)
  }
  const workspaces = [
    ...staticTitles.map((t) => ({ custom_title: t, current_directory: null })),
    ...launched.map((e) => ({ custom_title: e.title, current_directory: e.cwd })),
  ]
  process.stdout.write(JSON.stringify({ workspaces }))
  process.exit(0)
}

// `new-workspace` (el único camino que de verdad lanzaría algo real — nunca
// se invoca desde los tests de staleness/verificación en solitario, solo
// desde los de dispatch real, y siempre contra este stub).
const nameIdx = argv.indexOf('--name')
const name = nameIdx !== -1 ? argv[nameIdx + 1] : ''
const cwdIdx = argv.indexOf('--cwd')
const cwd = cwdIdx !== -1 ? argv[cwdIdx + 1] : null
const commandIdx = argv.indexOf('--command')
const command = commandIdx !== -1 ? argv[commandIdx + 1] : null

// ===========================================================================
// F19/H1 — EL STUB AHORA SIMULA LO QUE `--command` DE VERDAD HACE.
//
// La ayuda del cmux instalado en esta máquina (leída con `strings` sobre el
// binario, sin ejecutarlo nunca) dice, para `new-workspace`:
//
//     --command <text>     Send text+Enter to the new workspace after creation
//
// No es un exec: son PULSACIONES enviadas a un shell de login interactivo.
// Hasta F19 este stub ignoraba `--command` por completo, así que TODA la
// suite comprobaba el despacho sin que el comando se ejecutara jamás — el
// mismo punto ciego que dejó pasar el hallazgo de campo (una ventana abierta
// contada como agente lanzado). Ahora el stub ejecuta el texto con `sh -c` en
// el `--cwd` pedido, que es la parte de la semántica real que importa aquí:
// el comando corre, en ese directorio, en un shell.
//
// Lo que NO se simula (y se dice para no vender más de lo que es): no hay pty,
// ni rc de usuario, ni asincronía — el comando corre síncronamente dentro de
// `new-workspace`. Lo que sí se puede simular, y es lo que hacía falta, es que
// el texto llegue CORROMPIDO o no llegue.
//
//   FAKE_CMUX_EAT_FIRST_CHAR_SUBSTR — reproduce el hallazgo exacto: el prompt
//     de oh-my-zsh se come el primer carácter y `. /tmp/…` entra como
//     ` /tmp/…`. El shell falla, el centinela no se escribe, y cmux devuelve 0
//     igualmente porque `new-workspace` ya había terminado su trabajo.
//   FAKE_CMUX_SKIP_COMMAND_SUBSTR — el texto no llega en absoluto.
//   FAKE_CMUX_NO_CLAUDE_IN_SHELL — el comando corre, pero en un shell donde
//     `claude` no está en el PATH (el caso que el preflight de ct-next.mjs
//     solo podía sospechar, porque mira SU propio PATH y no el del shell de
//     login que abre cmux).
//
// El `claude` que ve ese shell simulado es un stub SILENCIOSO propio
// (fake-cmux-shell-bin), no el de fake-claude-bin: aquel existe para gritar si
// ct-next.mjs ejecuta `claude` por su cuenta —cosa que sigue sin hacer, y ese
// contrato no se toca— mientras que ESTE es el que la sesión de cmux lanzaría
// de verdad.
const here = dirname(fileURLToPath(import.meta.url))
const shellBin = join(here, '..', 'fake-cmux-shell-bin')

//   FAKE_CMUX_COMMAND_CWD — el comando corre en OTRO directorio (el caso en
//     que cmux tolera un `--cwd` inexistente y arranca en el shell de login
//     por defecto). Aquí lo que miente no es cmux: es la realidad, y el `$PWD`
//     del centinela es quien la delata.
//   FAKE_CMUX_COMMAND_DELAY_MS — el comando corre EN SEGUNDO PLANO tras ese
//     retraso, para poder separar "el centinela no ha aparecido TODAVÍA" de
//     "no va a aparecer". Es la única de estas variables que hace el stub
//     asíncrono, y existe precisamente porque esa distinción es temporal y no
//     se puede probar de ninguna otra forma.
function runTypedCommand(text) {
  if (text === null) return
  const eat = process.env.FAKE_CMUX_EAT_FIRST_CHAR_SUBSTR
  const skip = process.env.FAKE_CMUX_SKIP_COMMAND_SUBSTR
  if (skip && name.includes(skip)) return
  const typed = eat && name.includes(eat) ? text.slice(1) : text
  // PATH del shell simulado: el `claude` silencioso delante (salvo que el test
  // pida que no exista), y nada más del entorno del test que pueda confundir.
  const path = process.env.FAKE_CMUX_NO_CLAUDE_IN_SHELL
    ? '/usr/bin:/bin'
    : `${shellBin}:/usr/bin:/bin`
  const forced = process.env.FAKE_CMUX_COMMAND_CWD
  const runDir = forced || (cwd && existsSync(cwd) ? cwd : process.cwd())
  const delay = Number(process.env.FAKE_CMUX_COMMAND_DELAY_MS || 0)
  // Con retraso, se lanza en segundo plano y `new-workspace` vuelve YA — igual
  // que el cmux real, que no espera a que el shell haga nada.
  const line = delay > 0 ? `( sleep ${delay / 1000} ; ${typed} ) >/dev/null 2>&1 &` : typed
  spawnSync('/bin/sh', ['-c', line], {
    cwd: existsSync(runDir) ? runDir : process.cwd(),
    env: { ...process.env, PATH: path },
    stdio: 'ignore',
  })
}

// FAKE_CMUX_NEW_WORKSPACE_WAIT_FILE (F8): se queda DENTRO del `new-workspace`
// hasta que el test cree el fichero centinela. La invocación ya quedó
// registrada arriba en FAKE_CMUX_INVOKED_LOG_FILE (síncrono), así que el test
// puede detectar por fichero que ct-next está bloqueado dentro de esta llamada
// y mandarle una señal sin depender de acertar una ventana de tiempo. Ver
// __tests__/fixtures/stub-wait.js.
waitForReleaseFile('FAKE_CMUX_NEW_WORKSPACE_WAIT_FILE')

if (process.env.FAKE_CMUX_FAIL) {
  console.error('fake-cmux: new-workspace failed (simulado)')
  process.exit(1)
}
if (process.env.FAKE_CMUX_FAIL_NAME_SUBSTR && name.includes(process.env.FAKE_CMUX_FAIL_NAME_SUBSTR)) {
  console.error('fake-cmux: new-workspace failed (simulado, por nombre)')
  process.exit(1)
}
// FAKE_CMUX_WRONG_CWD_SUBSTR (finding 3): simula el escenario exacto del
// hallazgo — cmux "acepta" el lanzamiento (exit 0) pero la sesión queda en
// otro directorio (cwd inexistente, shell de login por defecto). Solo
// afecta al REGISTRO de estado (lo que luego ve `workspace list`), nunca al
// exit code de `new-workspace` — eso es precisamente lo que hace real el
// escenario: cmux no avisa de nada.
if (process.env.FAKE_CMUX_WRONG_CWD_SUBSTR && name.includes(process.env.FAKE_CMUX_WRONG_CWD_SUBSTR)) {
  // El comando SÍ se ejecuta, y en el cwd bueno: lo que este escenario simula
  // es que cmux REPORTA otro directorio para su ventana. Son dos fuentes
  // distintas (el `$PWD` del shell vs. el `current_directory` de cmux) y la
  // discrepancia entre ellas es justo lo que este caso ejerce.
  runTypedCommand(command)
  appendState({ title: name, cwd: '/Users/fake/.config/ghostty-default-shell-dir' })
  process.exit(0)
}
// FAKE_CMUX_SKIP_STATE_SUBSTR (finding 3): simula "cmux dijo éxito pero la
// sesión no aparece al consultar" — ninguna escritura de estado para este
// lanzamiento en concreto, aunque el exit code siga siendo 0.
if (process.env.FAKE_CMUX_SKIP_STATE_SUBSTR && name.includes(process.env.FAKE_CMUX_SKIP_STATE_SUBSTR)) {
  runTypedCommand(command)
  process.exit(0)
}
runTypedCommand(command)
appendState({ title: name, cwd })
process.exit(0)

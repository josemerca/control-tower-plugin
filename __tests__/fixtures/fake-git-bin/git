#!/usr/bin/env node
// Stub de `git` para los tests de ct-next.mjs (review round 1, finding
// Important sobre worktree huérfano): NUNCA toca un repo real. Controlado
// enteramente por variables de entorno para simular `worktree add`,
// `worktree remove` y `branch -D` exitosos o fallidos en puntos concretos, y
// registra cada invocación (comando + argv) en un fichero de log para que el
// test verifique qué intentó ct-next.mjs y en qué orden — igual que
// fake-gh-bin/gh hace para los tests de dispatch-check.
import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs'
import { dirname } from 'node:path'
import { waitForReleaseFile } from '../stub-wait.js'

const argv = process.argv.slice(2)
const joined = argv.join(' ')

if (process.env.FAKE_GIT_LOG_FILE) {
  appendFileSync(process.env.FAKE_GIT_LOG_FILE, joined + '\n')
}

// main(): toda la lógica del stub vive en una función (no en el top-level del
// módulo) para poder usar `return` en vez de `process.exit()` en la rama de
// "cuelgue" (finding 1, más abajo) — un `return` en el top-level de un
// módulo ES es un SyntaxError, y necesitamos poder terminar de decidir sin
// caer en el fallback de "comando no soportado" del final del fichero.
function main() {
  if (argv[0] === 'rev-parse' && argv[1] === '--show-toplevel') {
    process.stdout.write(`${process.env.FAKE_GIT_TOPLEVEL || '/tmp/fake-repo-root'}\n`)
    process.exit(0)
  }

  // `git rev-parse --verify --quiet <ref>^{commit}` (W-D, fix round 1,
  // Important): ct-next.mjs comprueba OFFLINE, contra el checkout local, que
  // la rama base resuelta (vía `gh repo view` o `--base`) existe de verdad
  // ANTES de reclamar/despachar nada — ver verifyBaseExistsLocally en
  // ct-next.mjs. Por defecto (ninguna de las dos variables de abajo fijada)
  // CUALQUIER ref "existe", para que los tests existentes (que no fijan
  // ninguna de las dos y asumían implícitamente que "main" resolvía) sigan
  // pasando sin cambios. FAKE_GIT_BASE_NOT_LOCAL hace fallar la comprobación
  // de la rama LOCAL; FAKE_GIT_BASE_NOT_REMOTE hace fallar la de
  // `origin/<rama>` — se distinguen por si el ref empieza por "origin/", para
  // poder simular por separado "no existe en ningún sitio" y "existe en
  // origin pero no en local".
  // `git rev-parse --verify --quiet refs/heads/feat/<n>` (finding 2 —
  // detección de staleness, assessLocalLiveness en ct-next.mjs): forma de
  // ref DISTINTA a la del chequeo de rama base de arriba/abajo (esta lleva
  // el prefijo `refs/heads/` y NUNCA el sufijo `^{commit}`) para que ambos
  // stubs puedan controlarse de forma INDEPENDIENTE — sin esto, el default
  // "cualquier ref existe" del bloque de abajo (pensado para la rama base)
  // haría que TODO issue pareciera siempre tener una rama local viva, sin
  // forma de que un test simule "sin rama" para un issue concreto.
  // FAKE_GIT_STALE_BRANCH_EXISTS: lista de números de issue (separados por
  // coma) para los que la rama SÍ existe — por defecto (variable ausente)
  // NINGUNA existe, lo contrario del default de la comprobación de rama
  // base, porque el escenario que motiva esta detección (finding 2) es
  // precisamente "no hay rama" y los tests deben poder partir de ahí sin
  // tener que apagar nada.
  if (argv[0] === 'rev-parse' && argv[1] === '--verify' && argv[2] === '--quiet' && /^refs\/heads\/feat\/\d+$/.test(argv[3] || '')) {
    // FAKE_GIT_REV_PARSE_BROKEN (D4): simula una CONSULTA rota (repo
    // corrupto, .git ilegible) — git sale con 128, no con 1. ct-next.mjs
    // distingue los dos: 1 = "la ref no existe" (respuesta), cualquier otro
    // = "no pude preguntar" (aviso, nunca "está libre").
    if (process.env.FAKE_GIT_REV_PARSE_BROKEN) {
      console.error('fake-git: fatal: not a git repository (simulado)')
      process.exit(128)
    }
    const n = (argv[3] || '').replace('refs/heads/feat/', '')
    const existing = (process.env.FAKE_GIT_STALE_BRANCH_EXISTS || '').split(',').map((s) => s.trim()).filter(Boolean)
    if (!existing.includes(n)) process.exit(1)
    process.stdout.write('deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\n')
    process.exit(0)
  }

  if (argv[0] === 'rev-parse' && argv[1] === '--verify' && argv[2] === '--quiet') {
    const ref = argv[3] || ''
    const isRemoteRef = ref.startsWith('origin/')
    const shouldFail = isRemoteRef ? process.env.FAKE_GIT_BASE_NOT_REMOTE : process.env.FAKE_GIT_BASE_NOT_LOCAL
    if (shouldFail) process.exit(1)
    process.stdout.write('deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\n')
    process.exit(0)
  }

  // Guarda de identidad de repo de ct-next.mjs (review final, finding 1):
  // FAKE_GIT_REMOTE_FAIL simula un checkout sin remote `origin` (exit != 0,
  // nada en stdout). Por defecto el origin es "https://github.com/o/r.git",
  // para que los tests existentes que usan `--repo o/r` sigan pasando sin
  // tener que fijar esta variable — solo los tests que quieren ejercitar un
  // MISMATCH deliberado fijan FAKE_GIT_REMOTE_ORIGIN a otra cosa.
  if (argv[0] === 'remote' && argv[1] === 'get-url' && argv[2] === 'origin') {
    if (process.env.FAKE_GIT_REMOTE_FAIL) {
      console.error('fake-git: remote get-url origin failed (simulado, sin remote origin)')
      process.exit(1)
    }
    process.stdout.write(`${process.env.FAKE_GIT_REMOTE_ORIGIN || 'https://github.com/o/r.git'}\n`)
    process.exit(0)
  }

  // `git worktree list --porcelain` (D4): ct-next.mjs lo consulta en el
  // preflight para detectar un worktree REGISTRADO cuyo directorio ya no
  // existe (borrado a mano, sin `git worktree remove`) — ese caso hace
  // fallar a `git worktree add` con "missing but already registered
  // worktree", y en el run real eso ocurriría con el claim ya escrito.
  // FAKE_GIT_WORKTREE_REGISTERED: rutas registradas extra, separadas por
  // coma. Por defecto solo está registrado el propio toplevel, que es lo que
  // devuelve un repo normal sin worktrees.
  if (argv[0] === 'worktree' && argv[1] === 'list') {
    if (process.env.FAKE_GIT_WORKTREE_LIST_FAIL) {
      console.error('fake-git: worktree list failed (simulado)')
      process.exit(1)
    }
    const top = process.env.FAKE_GIT_TOPLEVEL || '/tmp/fake-repo-root'
    const extra = (process.env.FAKE_GIT_WORKTREE_REGISTERED || '').split(',').map((s) => s.trim()).filter(Boolean)
    const out = [top, ...extra].map((p) => `worktree ${p}\n\n`).join('')
    process.stdout.write(out)
    process.exit(0)
  }

  if (argv[0] === 'worktree' && argv[1] === 'add') {
    // FAKE_GIT_WORKTREE_ADD_HANG (finding 1 — auditoría de interrupción):
    // NUNCA termina por su cuenta, e IGNORA SIGINT/SIGTERM — reproduce el
    // escenario MÁS ADVERSO del auditor (un `git worktree add` colgado que
    // ni siquiera muere si la señal llegara a alcanzarlo directamente).
    // Existe para probar que ct-next.mjs acota la espera con su propio
    // timeout (defensa 2 de finding 1) en vez de quedarse bloqueado para
    // siempre — sin este stub no hay forma de ejercer ese camino sin colgar
    // de verdad al runner de tests.
    if (process.env.FAKE_GIT_WORKTREE_ADD_HANG) {
      process.on('SIGINT', () => {})
      process.on('SIGTERM', () => {})
      setInterval(() => {}, 1000)
      return
    }
    // FAKE_GIT_WORKTREE_ADD_WAIT_FILE (F8): se queda DENTRO del `worktree
    // add` hasta que el test cree el fichero centinela, y entonces continúa
    // con éxito. Es el sustituto sin reloj de FAKE_GIT_WORKTREE_ADD_DELAY_MS
    // para los tests que necesitan mandar una señal "mientras `git worktree
    // add` está corriendo": el argv ya se registró en FAKE_GIT_LOG_FILE
    // arriba (síncrono), así que el test detecta por fichero que estamos
    // aquí dentro y suelta la señal sin ninguna prisa. A diferencia de
    // FAKE_GIT_WORKTREE_ADD_HANG (que no vuelve NUNCA, para ejercer el
    // timeout), este SÍ vuelve — y con éxito — en cuanto se le suelta.
    // Ver __tests__/fixtures/stub-wait.js.
    waitForReleaseFile('FAKE_GIT_WORKTREE_ADD_WAIT_FILE')
    // FAKE_GIT_WORKTREE_ADD_DELAY_MS: ensancha DETERMINÍSTICAMENTE la
    // ventana de tiempo real entre "claim confirmado" y "worktree add
    // completo" — necesario para probar el checkpoint de finding 1 A VALOR
    // DE PRODUCCIÓN (CT_NEXT_TEST_DELAY_AFTER_CLAIM_MS sin fijar, 0):
    // verificado por construcción que, sin ningún retraso en absoluto, la
    // tubería entera (stubs de gh/git/cmux, todos procesos node reales pero
    // triviales) puede completarse en unos pocos milisegundos — más rápido
    // de lo que tarda el propio test en reaccionar al evento 'data' de
    // "claimed #N" y despachar la señal, dando un ~20% de falsos "no
    // interrumpido a tiempo" que no tienen nada que ver con el propio
    // checkpoint (el proceso hijo terminaba entero antes de que la señal
    // llegara a procesarse en absoluto). Retrasar aquí (síncrono, en el
    // HIJO, simulando la latencia real de un `git worktree add` de verdad)
    // le da al test margen de sobra sin tocar el valor de
    // CT_NEXT_TEST_DELAY_AFTER_CLAIM_MS que se está verificando.
    if (process.env.FAKE_GIT_WORKTREE_ADD_DELAY_MS) {
      const sab = new Int32Array(new SharedArrayBuffer(4))
      Atomics.wait(sab, 0, 0, Number(process.env.FAKE_GIT_WORKTREE_ADD_DELAY_MS))
    }
    if (process.env.FAKE_GIT_WORKTREE_ADD_FAIL) {
      console.error('fake-git: worktree add failed (simulado)')
      process.exit(1)
    }
    // FAKE_GIT_WORKTREE_ADD_AS_FILE (D4): crea la ruta del worktree como un
    // FICHERO en vez de como un directorio, para que el `mkdirSync(
    // `${wt}/.agent`)` posterior de ct-next.mjs falle con ENOTDIR de forma
    // determinista y sin depender de permisos. Sustituye al truco anterior
    // de los tests (pre-crear `.worktrees/<n>` como fichero ANTES de correr
    // ct-next.mjs), que dejó de servir cuando ct-next.mjs pasó a comprobar
    // que el destino esté libre ANTES de reclamar (D4, defecto 3): con esa
    // comprobación, el pre-creado ya no llega nunca al paso del seed — se
    // detecta antes, que es justo el arreglo. Crearlo DURANTE el `worktree
    // add` reproduce el mismo fallo del seed sin desactivar la comprobación
    // nueva: el destino estaba libre cuando se miró, y algo salió mal
    // después. `-b <branch> <wt> <base>` → argv[3] es la ruta del worktree.
    if (process.env.FAKE_GIT_WORKTREE_ADD_AS_FILE) {
      const wt = argv[argv.indexOf('-b') + 2]
      mkdirSync(dirname(wt), { recursive: true })
      writeFileSync(wt, '')
      process.exit(0)
    }
    process.exit(0)
  }

  if (argv[0] === 'worktree' && argv[1] === 'remove') {
    if (process.env.FAKE_GIT_WORKTREE_REMOVE_FAIL) {
      console.error('fake-git: worktree remove failed (simulado)')
      process.exit(1)
    }
    process.exit(0)
  }

  if (argv[0] === 'branch' && argv[1] === '-D') {
    if (process.env.FAKE_GIT_BRANCH_DELETE_FAIL) {
      console.error('fake-git: branch -D failed (simulado)')
      process.exit(1)
    }
    process.exit(0)
  }

  console.error(`fake-git: comando no soportado en el stub: ${joined}`)
  process.exit(1)
}

main()
